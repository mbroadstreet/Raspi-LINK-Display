def bounded_remaining(deadline):
    budget = deadline - time.monotonic()
    if budget <= 0:
        raise LaunchError('Bounded diagnostic deadline exceeded')
    return budget


def bounded_canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True).encode('ascii')


def bounded_digest(value):
    return hashlib.sha256(bounded_canonical(value)).hexdigest()


def bounded_binding(record):
    validate_record(record)
    i = record['identity']
    if record['provenance']['kind'] != 'launch' or i is None or record['invocation_id'] is None:
        raise ValueError('No genuine captured invocation')
    for value, bits, minimum in [(i['pid'],31,1),(int(i['start_ticks']),64,1),(i['exe_device'],64,0),(i['exe_inode'],64,1)]:
        if type(value) is not int or not minimum <= value < 2**bits:
            raise ValueError('Identity outside native widths')
    return bounded_digest({k:v for k,v in record.items() if k != 'phase'})


