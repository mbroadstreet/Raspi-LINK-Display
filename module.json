{
  "module_name": "raspi-link-display",
  "display_name": "Raspberry Pi Ableton Link Display",
  "module_type": "display",
  "version": "0.4.0",
  "validated_tag": "v0.4-pi-validated",
  "validated_commit": "a79db44",
  "runtime": "native-cpp-sdl2",
  "language": "c++17",
  "display_target": "480x320",
  "primary_protocols": [
    "ableton-link"
  ],
  "inputs": [
    "keyboard"
  ],
  "outputs": [
    "sdl2-display",
    "console-no-gui"
  ],
  "controls": [
    "F1",
    "F",
    "P",
    "R",
    "Q",
    "Esc"
  ],
  "config_file": "config/link-pi-display.example.conf",
  "external_control": "not implemented",
  "container_integration": "future",
  "manual_start": true,
  "systemd_enabled": false,
  "inspection_commands": [
    "--print-config",
    "--module-info"
  ]
}